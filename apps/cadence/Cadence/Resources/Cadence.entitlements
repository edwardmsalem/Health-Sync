<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CloudKit private database: carries app preferences between devices.
	     The calendar and task data itself already syncs via iCloud/Google/Todoist. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.salemseats.cadence</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)com.salemseats.cadence</string>

	<!-- Silent CloudKit change pushes. -->
	<key>aps-environment</key>
	<string>development</string>

	<!-- macOS sandbox. Without the calendars entitlement EventKit is denied
	     on macOS even after the user grants permission. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
