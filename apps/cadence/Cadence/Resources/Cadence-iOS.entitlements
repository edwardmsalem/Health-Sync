<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Intentionally empty for now.
	     CloudKit needs an iCloud container, and Apple's API cannot create
	     containers (portal-only), so the first TestFlight builds ship without
	     the entitlement; preferences stay on-device. To turn sync on:
	     1. developer.apple.com > Identifiers > com.salemseats.cadence >
	        iCloud > assign container iCloud.com.salemseats.cadence
	     2. restore the icloud keys here (copy from Cadence-macOS.entitlements)
	     3. add CADENCE_CLOUDKIT to the iOS compilation conditions in
	        project.yml (see SWIFT_ACTIVE_COMPILATION_CONDITIONS note there) -->
</dict>
</plist>
