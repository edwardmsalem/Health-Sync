      },
      {
        "comment": "",
        "key": "Your settings sync between your Apple devices through iCloud. Events and tasks sync through their own accounts, so they are already up to date everywhere.",
        "location": {
          "startingColumn": 22,
          "startingLine": 328
        }
      },
      {
        "comment": "",
        "key": "Settings stay on this device. iCloud sync needs a build signed with a development team — set DEVELOPMENT_TEAM and regenerate the project. Events and tasks still sync through their own accounts.",
