# Cadence → TestFlight, modelled on SalemTriage's Fastfile.
#
# One deliberate difference: SalemTriage's lanes were written for GitHub
# Actions with match-based signing, but that CI never went green — every real
# ship has been a local build. These lanes make the local path the first-class
# one: signing comes from the App Store Connect API key on this Mac
# (~/.appstoreconnect/private_keys), via cert/sigh rather than match, so no
# match passphrase is needed. The lanes still run in CI unchanged if the same
# key is provided through env vars.

APP_IDENTIFIER = "com.salemseats.cadence"
TEAM_ID = ENV["TEAMID"] || "AF6MS7483E"
ASC_KEY_ID = ENV["FASTLANE_KEY_ID"] || "H9G393X95Z"
ASC_ISSUER_ID = ENV["FASTLANE_ISSUER_ID"] || "090a0349-b8f8-45a4-8da9-b37e34aede77"
ASC_KEY_PATH = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ASC_KEY_ID}.p8")

ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"

def cadence_api_key
  if ENV["FASTLANE_KEY"] && !ENV["FASTLANE_KEY"].empty?
    app_store_connect_api_key(
      key_id: ASC_KEY_ID,
      issuer_id: ASC_ISSUER_ID,
      key_content: ENV["FASTLANE_KEY"]
    )
  else
    app_store_connect_api_key(
      key_id: ASC_KEY_ID,
      issuer_id: ASC_ISSUER_ID,
      key_filepath: ASC_KEY_PATH
    )
  end
end

platform :ios do
  desc "One-time: register the bundle ID (with iCloud) and the App Store Connect app record"
  lane :register do
    # produce does not read the api key from lane context; hand it the key
    # file directly.
    produce(
      api_key_path: nil,
      api_key: {
        key_id: ASC_KEY_ID,
        issuer_id: ASC_ISSUER_ID,
        key: File.read(ASC_KEY_PATH),
        duration: 500,
        in_house: false
      },
      app_identifier: APP_IDENTIFIER,
      app_name: ENV["CADENCE_APP_NAME"] || "Salem Cadence",
      language: "en-US",
      sku: APP_IDENTIFIER,
      enable_services: {
        icloud: "cloudkit"
      },
      skip_itc: false
    )
  end

  desc "Build a signed IPA"
  lane :build do
    api_key = cadence_api_key

    previous_build_number = begin
      latest_testflight_build_number(
        app_identifier: APP_IDENTIFIER,
        api_key: api_key
      )
    rescue
      0
    end
    current_build_number = previous_build_number + 1

    sh("cd .. && xcodegen generate")

    # Signing via match, same as SalemTriage: the team is at Apple's
    # two-distribution-cert limit, and the only recoverable private key lives
    # encrypted in the shared Match-Secrets repo. Requires MATCH_PASSWORD in
    # the environment. The GitHub token comes from GH_PAT or, locally, from
    # the gh CLI's keyring.
    gh_token = ENV["GH_PAT"] || sh("gh auth token", log: false).strip
    match(
      type: "appstore",
      app_identifier: [APP_IDENTIFIER],
      api_key: api_key,
      git_url: "https://github.com/edwardmsalem/Match-Secrets.git",
      git_basic_authorization: Base64.strict_encode64("edwardmsalem:#{gh_token}"),
      readonly: false
    )

    profile_name = Actions.lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][APP_IDENTIFIER]

    gym(
      project: "Cadence.xcodeproj",
      scheme: "Cadence",
      configuration: "Release",
      destination: "generic/platform=iOS",
      output_name: "Cadence.ipa",
      output_directory: "artifacts",
      buildlog_path: "buildlog",
      skip_package_dependencies_resolution: false,
      xcargs: [
        "CODE_SIGN_STYLE=Manual",
        "DEVELOPMENT_TEAM=#{TEAM_ID}",
        "CODE_SIGN_IDENTITY='Apple Distribution'",
        "PROVISIONING_PROFILE_SPECIFIER='#{profile_name}'",
        "CURRENT_PROJECT_VERSION=#{current_build_number}"
      ].join(" "),
      export_method: "app-store-connect",
      export_options: {
        method: "app-store-connect",
        signingStyle: "manual",
        teamID: TEAM_ID,
        provisioningProfiles: {
          APP_IDENTIFIER => profile_name
        }
      }
    )
  end

  desc "Upload the built IPA to TestFlight"
  lane :release do
    api_key = cadence_api_key

    upload_to_testflight(
      api_key: api_key,
      ipa: "artifacts/Cadence.ipa",
      skip_submission: false,
      skip_waiting_for_build_processing: true,
      changelog: last_git_commit[:message].lines.first.to_s.strip
    )
  end

  desc "Build and upload in one go"
  lane :ship do
    build
    release
  end
end
